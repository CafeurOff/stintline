# Public demo settings (infra/docker-compose.demo.yml). Copy to infra/demo.env (git-ignored).
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Host names the site answers on (comma-separated), and the HTTPS origin for CSRF.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Keep true behind a TLS proxy. Set to false only to try the stack over plain HTTP locally.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# Official driver portraits and car renders, linked from their original URLs (ADR 0006,
# ADR 0014). Set to false to show Wikipedia portraits and the original illustrations instead.
OFFICIAL_MEDIA_ENABLED=true

DEMO_PORT=8080
