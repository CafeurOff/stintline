# Copy to .env (git-ignored) and adjust. `make setup` and `make up` do this for you.
# Nothing here is a real secret: generate your own values outside local development.

# --- Django
# Required. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-local-development-only
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_ADMIN_ENABLED=true
# Production only
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database (docker compose service "postgres")
POSTGRES_DB=stintline
POSTGRES_USER=stintline
POSTGRES_PASSWORD=stintline-local
DATABASE_URL=postgres://stintline:stintline-local@localhost:5432/stintline
DATABASE_CONN_MAX_AGE=60

# --- Redis (Celery broker, Channels layer, cache)
REDIS_URL=redis://localhost:6379/0

# --- HTTP
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging
LOG_JSON=false
LOG_LEVEL=INFO

# --- Web (dev server proxy target; docker compose overrides it with http://api:8000)
VITE_API_PROXY_TARGET=http://localhost:8000

# --- Data providers (all free, no account needed; see docs/data-sources.md)
OPENF1_BASE_URL=https://api.openf1.org/v1
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# Ingestion: "http" (live APIs) or "fixtures" (offline recordings)
RACEDATA_MODE=http
RACEDATA_CACHE_DIR=

# Official driver portraits and car renders, as URLs only (ADR 0006). Set false to use illustrations.
OFFICIAL_MEDIA_ENABLED=true
