# StintLine — Celery worker for team radio transcripts only (queue `radio`, Whisper base.en
# on the CPU, ADR 0029). Apart from the import worker, so a backlog never holds a Grand Prix
# import up; one fresh process per task, so the model's memory is given back every time.
# Installed by vps-infra app-apply; runs /opt/stintline/current.
[Unit]
Description=StintLine Celery worker (team radio transcripts)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=stintline
Group=stintline
WorkingDirectory=/opt/stintline/current/apps/api
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=LOG_JSON=true
# Provider responses cache (racedata); the release itself is read-only for the app.
Environment=RACEDATA_CACHE_DIR=/var/lib/stintline/racedata-cache
# Whisper checkpoint for team radio transcripts (ADR 0029), downloaded on first use.
Environment=RADIO_WHISPER_DIR=/var/lib/stintline/whisper-models
# Two threads (about 2 s per clip): leaves the other cores to the server's other apps.
Environment=RADIO_WHISPER_THREADS=2
# Generated by app-apply (DATABASE_URL, REDIS_URL, APP_DATA_DIR), then the app's secrets.
EnvironmentFile=/etc/stintline/vps.env
EnvironmentFile=/etc/stintline/stintline.env
# One process (clips are fetched under the relay's rate limit, enforced in-process). A new
# child for every task: CTranslate2 keeps its arenas after the model is released, and a
# reused child grew past MemoryMax over a few hours of backlog (killed 3 times, 2026-11-22).
ExecStart=/opt/stintline/current/apps/api/venv/bin/celery -A config worker \
    --loglevel=INFO --concurrency=1 --queues=radio --max-tasks-per-child=1 \
    --hostname=radio@%%h
Restart=on-failure
RestartSec=10
# A batch of 25 clips takes about a minute: let it finish or be re-queued (acks_late).
TimeoutStopSec=60
# A transcription batch peaks at about 800 MB (Django + Whisper, measured on 195 clips);
# below that, MemoryHigh throttles the task into a reclaim stall.
MemoryHigh=1100M
MemoryMax=1280M
MemorySwapMax=64M

# Sandbox (systemd-analyze security <unit>: aim <= 3). vps-infra docs/conventions/01-systemd-unit.md
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# numpy/scipy (imported with the Django apps) set a NUMA memory policy through OpenBLAS:
# without these the process is killed at startup with SIGSYS (seen with malo on this server).
SystemCallFilter=mbind set_mempolicy get_mempolicy
# CTranslate2 (Whisper, team radio transcripts) pins its threads with sched_setaffinity when
# the model loads: without it the task is killed with SIGSYS (ADR 0029).
SystemCallFilter=sched_setaffinity
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/lib/stintline /var/log/stintline

[Install]
WantedBy=multi-user.target
