# StintLine — live process (ADR 0011, 0030): follows the official live timing hub through the
# relay, publishes a snapshot every half second to the Redis cache and /ws/live, and transcribes
# new team radio clips (Whisper base.en, ~500 MB). Primary server only (SCHEDULED_UNITS).
# Installed by vps-infra app-apply; runs /opt/stintline/current.
[Unit]
Description=StintLine live timing process
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=stintline
Group=stintline
WorkingDirectory=/opt/stintline/current/apps/api
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=LOG_JSON=true
Environment=RACEDATA_CACHE_DIR=/var/lib/stintline/racedata-cache
Environment=RADIO_WHISPER_DIR=/var/lib/stintline/whisper-models
Environment=RADIO_WHISPER_THREADS=2
# Generated by app-apply (DATABASE_URL, REDIS_URL, APP_DATA_DIR), then the app's secrets
# (RADIO_RELAY_URL / RADIO_RELAY_TOKEN: the hub refuses this server's address).
EnvironmentFile=/etc/stintline/vps.env
EnvironmentFile=/etc/stintline/stintline.env
# Reconnects to the hub by itself with back-off; between sessions it idles on the connection.
ExecStart=/opt/stintline/current/apps/api/venv/bin/python manage.py live
Restart=always
RestartSec=10
TimeoutStopSec=15
# Django + Whisper in the radio thread: same budget as the worker.
MemoryHigh=1100M
MemoryMax=1280M
MemorySwapMax=64M

# Sandbox (systemd-analyze security <unit>: aim <= 3). vps-infra docs/conventions/01-systemd-unit.md
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# numpy/scipy (strategy engine) set a NUMA memory policy at import through OpenBLAS: without
# these the process is killed at startup with SIGSYS (seen with malo on this server).
SystemCallFilter=mbind set_mempolicy get_mempolicy
# CTranslate2 (Whisper, team radio transcripts) pins its threads with sched_setaffinity when
# the model loads: without it the task is killed with SIGSYS (ADR 0029).
SystemCallFilter=sched_setaffinity
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/lib/stintline /var/log/stintline

[Install]
WantedBy=multi-user.target
