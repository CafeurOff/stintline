# StintLine — Celery worker: imports (providers rate-limited in-process, ADR 0004), analysis,
# FIA documents, news. Installed by vps-infra app-apply; runs /opt/stintline/current.
[Unit]
Description=StintLine Celery worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=stintline
Group=stintline
WorkingDirectory=/opt/stintline/current/apps/api
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=LOG_JSON=true
# Provider responses cache (racedata); the release itself is read-only for the app.
Environment=RACEDATA_CACHE_DIR=/var/lib/stintline/racedata-cache
# Generated by app-apply (DATABASE_URL, REDIS_URL, APP_DATA_DIR), then the app's secrets.
EnvironmentFile=/etc/stintline/vps.env
EnvironmentFile=/etc/stintline/stintline.env
# One process: provider rate limits are enforced in-process (ADR 0004).
ExecStart=/opt/stintline/current/apps/api/venv/bin/celery -A config worker \
    --loglevel=INFO --concurrency=1 --hostname=stintline@%%H
Restart=on-failure
RestartSec=10
# Long imports (telemetry): let the current task finish or be re-queued (acks_late).
TimeoutStopSec=60
MemoryHigh=640M
MemoryMax=900M
MemorySwapMax=64M

# Sandbox (systemd-analyze security <unit>: aim <= 3). vps-infra docs/conventions/01-systemd-unit.md
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# numpy/scipy (strategy engine) set a NUMA memory policy at import through OpenBLAS: without
# these the process is killed at startup with SIGSYS (seen with malo on this server).
SystemCallFilter=mbind set_mempolicy get_mempolicy
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/lib/stintline /var/log/stintline

[Install]
WantedBy=multi-user.target
