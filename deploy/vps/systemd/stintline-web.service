# StintLine — API and web pages (uvicorn, 2 workers, 127.0.0.1:8020). Installed by vps-infra
# app-apply; runs the release /opt/stintline/current. nginx serves the built files itself.
[Unit]
Description=StintLine API (uvicorn, 127.0.0.1:8020)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=stintline
Group=stintline
WorkingDirectory=/opt/stintline/current/apps/api
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
Environment=LOG_JSON=true
# Provider responses cache (racedata); the release itself is read-only for the app.
Environment=RACEDATA_CACHE_DIR=/var/lib/stintline/racedata-cache
# Generated by app-apply (DATABASE_URL, REDIS_URL, APP_DATA_DIR), then the app's secrets.
EnvironmentFile=/etc/stintline/vps.env
EnvironmentFile=/etc/stintline/stintline.env
# Shared by the workers so /metrics merges their request metrics (ADR 0027).
# Emptied on every restart, as prometheus_client requires.
Environment=PROMETHEUS_MULTIPROC_DIR=/run/stintline-web-metrics
RuntimeDirectory=stintline-web-metrics
# --proxy-headers: the client address and scheme come from nginx (127.0.0.1 only).
ExecStart=/opt/stintline/current/apps/api/venv/bin/uvicorn config.asgi:application \
    --host 127.0.0.1 --port 8020 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
# 2 workers x ~180 MB with every season loaded. Under MemoryHigh requests stall, at
# MemoryMax the kernel OOM-kills and Restart= brings it back.
MemoryHigh=640M
MemoryMax=800M
MemorySwapMax=64M

# Sandbox (systemd-analyze security <unit>: aim <= 3). vps-infra docs/conventions/01-systemd-unit.md
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# numpy/scipy (strategy engine) set a NUMA memory policy at import through OpenBLAS: without
# these the process is killed at startup with SIGSYS (seen with malo on this server).
SystemCallFilter=mbind set_mempolicy get_mempolicy
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/lib/stintline /var/log/stintline

[Install]
WantedBy=multi-user.target
