# StintLine — manifest for vps-infra app-apply / app-release (data, never sourced).
# Reference: vps-infra app/README.md. Live process through a relay (ADR 0030).
#   bin/app-apply <server> stintline --repo <clone> --ref <tag>     (vps-infra)
#   vps deploy stintline <tag>                                      (on the server)
APP=stintline
APP_USER=stintline
REPO=https://github.com/CafeurOff/stintline.git
TAG_REGEX=^v[0-9]+\.[0-9]+\.[0-9]+$
UNITS="stintline-web.service stintline-worker.service"
# Primary server only (masked on a standby): two beats = every import queued twice, two live
# processes = two connections to the hub publishing over each other.
SCHEDULED_UNITS="stintline-beat.service stintline-live.service"
HOOK_STOPS="stintline-beat.service"
HEALTH_URL=http://127.0.0.1:8020/api/v1/health
BUILD=deploy/vps/build.sh
RELEASE_HOOK=deploy/vps/release.sh
# Each release holds its venv and the built web app (~350 MB).
KEEP_RELEASES=3
DB_NAME=stintline
DB_LOCALE=C.UTF-8
# One database for cache, Celery broker and results (REDIS_URL).
REDIS_DBS="6"
# Build: python3-venv (uv's bootstrap), xz-utils (the pinned Node tarball).
PACKAGES="python3-venv xz-utils"
BACKUP=yes
NTFY_TOPIC=stintline
