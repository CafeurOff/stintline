{
  "name": "@stintline/api-types",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript types generated from the StintLine OpenAPI schema. Do not edit src/schema.d.ts by hand.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.yaml --output src/schema.d.ts && prettier --write src/schema.d.ts",
    "check": "node scripts/check-generated.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src scripts",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "test": "node scripts/check-generated.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3"
  }
}
